# dependencies
node_modules/
.pnp
.pnp.js

# build output
out/
dist/
.next/

# env
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db
desktop.ini

# editors
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# playwright
playwright-report/
test-results/
.playwright/

# large binaries — never commit renders or reference videos
*.mp4
*.mov
*.avi
*.webm
*.wav

# personal reference reels (strip before committing)
examples/reference/
themes/*/reference.html

# plan docs — internal, not for the public repo
RESUMOTION_PLAN*.md
RESUMOTION_SKILL_PLAN.md

# scratch notes
ui.md
theme.md

# fonts bundled at build time — commit the woff2 files but not system fonts
assets/fonts/*.ttf
assets/fonts/*.otf

# temp
*.tmp
*.temp
frames/
