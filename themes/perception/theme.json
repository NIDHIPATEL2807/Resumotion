{
  "id": "perception",
  "name": "Perception",
  "version": "1.0.0",
  "for": "ML / CV / AI / robotics engineers",
  "bpm": 120,
  "key": "D minor",
  "palette_default": { "bg": "#000000", "fg": "#F2EDE6", "accent": "#FF6B2B", "muted": "#7a726b", "dim": "#2b2622" },
  "fonts": ["Syne", "JetBrains Mono"],
  "safe_motion": false,
  "scenes": {
