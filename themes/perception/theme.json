    "case_study":  { "beats": [10, 20], "max_stages": 5 },
    "project":     { "beats": [6, 12], "visuals": ["generic_detect", "route_draw", "depth_map", "build_bar", "script_cycle"] },
    "experience":  { "beats": [6, 12] },
    "wins_grid":   { "beats": [6, 12], "max_items": 5 },
    "stack_flash": { "beats": [2, 8],  "max_items": 20 },
